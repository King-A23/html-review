{
  "name": "html-review",
  "version": "1.0.0",
  "private": true,
  "description": "轻量、离线可用的本地 HTML 批注工具",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:bridge": "node tests/bridge.browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "html-review": "bin/html-review.mjs"
  }
}
